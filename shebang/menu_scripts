function _kill {
    local pid
    pid="$(ps a --no-headers --user "$(whoami)" --format=pid,comm,args --sort=comm |
        menu |
        awk '{print $1}')"
    if [[ -z "$pid" ]]; then exit 0; fi
    notify-send "Killing $pid"
    kill "$pid"
    notify-send "Killed $pid"
}

function minecraft {
    local instance="$(ls -d ~/.local/share/PrismLauncher/instances/*/ | while IF= read -r dir; do
        local name="$(echo "$dir" |
            sed 's/.\+instances\///' |
            sed 's/\/$//')"
        printf "%s" "$name"
        printf "\0icon\x1f%sminecraft/icon.png\n" "$dir"
    done | menu)"
    if [[ -z "$instance" ]]; then exit 0; fi
    prismlauncher --launch "$instance"
}

function resend_notif {
    count="$(text_input "How many notifications?")"
    resend_notification "$count"
}

function runtime {
    local runtime_info
    runtime_info="$(ps a --no-headers --user "$(whoami)" --format=pid,comm,args,start_time,etime --sort=comm | menu)"
    if [[ -z "$runtime_info" ]]; then exit 0; fi
    notify-send "$(echo "$runtime_info" | awk '{print "  Since: " $(NF-1)}')" "$(echo "$runtime_info" | awk '{print "Elapsed: " $NF}' | sed 's/-/ days /')"
}

function startup {
    # Before launching Discord and Thunderbird, applications that require internet access, make sure there is internet access. Wait up to 5 seconds for it.
    # (Stops waiting right away if there is a connection)
    if ! nm-online -t 5; then
        # If there isn't internet access even after 5 seconds
        notify-send "Startup failed because of lack of internet access"
        exit
    fi
    i3-msg "workspace number 2;move workspace to $left_monitor"
    i3-msg "workspace number 1;move workspace to output $right_monitor;exec discord;exec thunderbird"
    i3-msg 'workspace number 2' # Workspace 2 is on the left, but the current workspace on the left monitor will be workspace 3. This makes workspace 2 the active workspace on the left monitor
    i3-msg 'workspace number 1' # Focus workspace 1 so Discord opens in the correct workspace since it likes to launch a window, wait, close it, then launch another window
}


function timer {
    local name
    local duration
    name="$(text_input "Timer Name")"
    duration="$(text_input "Timer Duration")"
    if echo "$duration" | grep -Pv "^((\d+[smhd])|((\d+[smhd] )+(\d+[smhd])))$"; then
        notify-send "Invalid Duration"
    else
        sleep $duration
        notify-send -t 0 -u critical "$name timer finished after $duration"
        spd-say "$name timer finished"
    fi
}

function wallpaper {
    local wp_dir="$HOME/Pictures/Wallpapers"
    
    local res
    res=$(xrandr | grep '\*' | awk '{print $1}' | head -n 1)
    
    local rofi_theme='
        window { width: 60%; height: 70%; } 
        listview { columns: 4; lines: 3; flow: horizontal; } 
        element { orientation: vertical; padding: 10px; } 
        element-icon { size: 150px; horizontal-align: 0.5; } 
        element-text { horizontal-align: 0.5; }
    '

    local rofi_args=(
        -dmenu
        -show-icons
        -nocustom
        -i
        -theme gruvbox-dark
        -theme-str "$rofi_theme"
        -font "JetBrainsMonoNF 13"
    )

    local image
    image=$(
        find "$wp_dir" -type f \( -iname "*.jpg" -o -iname "*.png" -o -iname "*.webp" \) ! -name "current.png" -printf "%P\n" \
            | while read -r file; do
                echo -en "${file}\0icon\x1f${wp_dir}/${file}\n"
              done \
            | rofi "${rofi_args[@]}"
    )

    [[ -z "$image" ]] && return
    
    local full_path="$wp_dir/$image"
    local output_path="$wp_dir/current.png"

    mapfile -t color_array < <(grep -o '"#[a-fA-F0-9]\{6\}"' ~/.local/share/chezmoi/.chezmoidata.toml | tr -d '"\r' | sed 's/^/xc:/')

    magick -monitor "$full_path" \
      -filter point -resize "${res}^" -gravity center -extent "$res" \
      \( hald:8 -colorspace Oklab +dither \
         \( "${color_array[@]}" +append -write mpr:palette +delete \) \
         -remap mpr:palette -colorspace sRGB \
      \) \
      -interpolate Nearest -hald-clut \
      "$output_path" 2>&1 | tr '\r' '\n' | awk '
      BEGIN { phase = 1; last_pct = 0; notified = -1 }
      match($0, /([0-9]+)%/) {
          pct = substr($0, RSTART, RLENGTH-1) + 0
          
          if (pct < last_pct && (last_pct - pct) > 50) {
              phase++
              notified = -1
          }
          last_pct = pct
          
          if (pct % 10 == 0 && pct != notified) {
              if (phase == 1) { tag = "wp-load"; text = "1/3: Loading and resizing..." }
              else if (phase == 2) { tag = "wp-apply"; text = "2/3: Applying color palette..." }
              else { tag = "wp-save"; text = "3/3: Saving final image..." }
              
              system("notify-send -h int:value:" pct " -h string:x-dunst-stack-tag:" tag " \"Wallpaper\" \"" text "\"")
              notified = pct
          }
      }'

    hsetroot -cover "$output_path"
    
    notify-send -h string:x-dunst-stack-tag:wp-load -t 2000 "Wallpaper" "1/3: Load complete"
    notify-send -h string:x-dunst-stack-tag:wp-apply -t 2000 "Wallpaper" "2/3: Palette applied"
    notify-send -h string:x-dunst-stack-tag:wp-save -t 2000 "Wallpaper" "3/3: Wallpaper set!"
}

function xcompose {
    grep --no-filename '^<Multi_key>' /usr/share/X11/locale/en_US.UTF-8/Compose ~/.XCompose |
        sed -e 's/<Multi_key> <//' -e 's/\s\+/ /g' -e 's/> </ /g' -e 's/> :/:/' |
        menu |
        grep -o '"."' |
        grep -o '[^"]' |
        xclip -selection clipboard
}

case "$(echo -e "Balatro Mods\nDeadlock Timings\nkill\nMinecraft\nResend Notifications\nRuntime\nStartup\nTimer\nWallpaper\nXCompose" | menu)" in
    'Balatro Mods') balatro_mod ;;
    'Deadlock Timings') deadlock_timings ;;
    # direwolf20) direwolf ;;
    'kill') _kill ;;
    Minecraft) minecraft ;;
    'Resend Notifications') resend_notif ;;
    Runtime) runtime ;;
    Startup) startup ;;
    Timer) timer ;;
    Wallpaper) wallpaper ;;
    XCompose) xcompose ;;
    *) exit 1
esac
