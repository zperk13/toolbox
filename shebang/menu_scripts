#!/usr/bin/env bash
function menu {
    rofi -dmenu -show-icons -no-custom -i -theme gruvbox-dark -font "JetBrainsMonoNF 13" -p "$1" -no-fixed-num-lines || exit 0
}

function text_input {
    echo "" | rofi -dmenu -theme-str 'listview { enabled: false;}' -theme gruvbox-dark -font "JetBrainsMonoNF 13" -p "$1" || exit 0
}

left_monitor='output HDMI-A-1'
right_monitor='output DisplayPort-1'

function balatro_mod {
    local dir="$HOME/.local/share/Steam/steamapps/common/Balatro"
    case "$(echo -e "Enable\nDisable" | menu 'Balatro Modloader')" in
        Enable) mv "$dir/winmm.dll.disabled" "$dir/winmm.dll" && notify-send 'Balatro Modloader Enabled';;
        Disable) mv "$dir/winmm.dll" "$dir/winmm.dll.disabled" && notify-send 'Balatro Modloader Disabled';;
        *) exit 1
    esac
}

function deadlock_timings {
    notify-send -t 0 'Deadlock Timings' "2:00 Easy Jungles\n3:00 Crates + Golden Statues\n5:00 Bridge Buffs + Medium Jungles\n8:00 Hard Jungles + Sinner's Sacrifice\n10:00 Soul Urn + Mid-Boss + Bridge Buffs + Crates and Golden Statues above Mid-Boss\n12:00 Guardians max vulnerability\n15:00 and Every 5 minutes after: Soul Urn + Bridge Buffs"
}

